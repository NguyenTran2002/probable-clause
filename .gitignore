# Secrets (the agent never reads or edits .env; .env.example is committed)
.env
.env.*
!.env.example

# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Raw API responses and downloaded PDFs: cached locally, never committed (brief §4.3, default 3)
data/raw/
data/cache/
*.pdf

# Screenshots and images: never committed to this repo (locked-decisions P0.4).
# Only these formats are blocked; the project's own .svg and .ico files are allowed.
*.png
*.PNG
*.jpg
*.JPG
*.jpeg
*.JPEG

# Frontend
node_modules/
dist/

# Claude Code: personal settings stay local. Session transcripts live outside
# the repo and are never committed (brief §10.3)
.claude/settings.local.json

# OS / editors
.DS_Store
.idea/
.vscode/
