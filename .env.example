# Copy to .env and fill in. The agent never reads or edits .env.
# Check with: uv run python scripts/check_env.py
# (reports only whether each variable is set, never its value)

# Phase 1 only. Never deployed.
COURTLISTENER_API_TOKEN=

# Claude API (Phase 1 token counting onward)
ANTHROPIC_API_KEY=

# Exa, sent as the x-api-key header to Exa's hosted MCP server (brief §6.1)
EXA_API_KEY=

# The user's existing MongoDB Atlas cluster, readWrite-only user for this app (brief §8.4)
MONGODB_URI=

# Voyage AI (voyage-law-2 embeddings, rerank-3), sent as a bearer token (T1.1, T3.3)
VOYAGE_API_KEY=
